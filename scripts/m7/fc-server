#!/bin/sh
# Stands in for the server binary (SEGMENT_LOG_SERVER) in the Go tests: boots one Firecracker
# guest that runs the server on an ext4 log image (ADR 0059). Called as the server is:
#   fc-server --dir <host dir>/log [server flags...]
# The image is <host dir>/log.img and the VMM's vsock socket <host dir>/v.sock, so the client
# dials "firecracker" at "<host dir>/v.sock:<port>". This process becomes the VMM, so killing it
# destroys the guest and the volume survives.
#
# M7_CACHE holds firecracker, vmlinux and rootfs.ext4 (m7-rehearse.sh builds them).
# M7_CACHE_TYPE=Unsafe is the known-bad control for VOL-FLUSH-CONFIG.
set -eu
: "${M7_CACHE:?set M7_CACHE}"
[ "${1:-}" = --dir ] || { echo "fc-server: want --dir first" >&2; exit 64; }
host=$(dirname "$2")
shift 2
img=$host/log.img
if [ ! -e "$img" ]; then
	truncate -s "${M7_LOG_BYTES:-1G}" "$img"
	/sbin/mkfs.ext4 -q -F "$img"
fi
# V5: one VMM per volume. The lock rides on fd 9 into the VMM through exec, so it lasts exactly
# as long as the VMM process, including while it is paused.
exec 9<>"$img"
flock -xn 9 || { echo "fc-server: $img is attached to another VMM" >&2; exit 75; }
rm -f "$host/v.sock"
cat >"$host/vm.json" <<EOF
{
  "boot-source": {
    "kernel_image_path": "$M7_CACHE/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 ro init=/segment-log-init -- $*"
  },
  "drives": [
    {"drive_id": "root", "path_on_host": "$M7_CACHE/rootfs.ext4", "is_root_device": true, "is_read_only": true},
    {"drive_id": "log", "path_on_host": "$img", "is_root_device": false, "is_read_only": false,
     "cache_type": "${M7_CACHE_TYPE:-Writeback}"}
  ],
  "machine-config": {"vcpu_count": ${M7_VCPUS:-2}, "mem_size_mib": ${M7_MEM_MIB:-256}},
  "vsock": {"guest_cid": 3, "uds_path": "$host/v.sock"}
}
EOF
exec "$M7_CACHE/firecracker" --no-api --config-file "$host/vm.json" >"$host/console.log"
