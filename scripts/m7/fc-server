#!/bin/sh
# Stands in for the server binary (SEGMENT_LOG_SERVER) in the Go tests: boots one Firecracker
# guest that runs the server on an ext4 log image (ADR 0059). Called as the server is:
#   fc-server --dir <host dir>/log [server flags...]
# The image is <host dir>/log.img and the VMM's vsock socket <host dir>/v.sock, so the client
# dials "firecracker" at "<host dir>/v.sock:<port>". This process becomes the VMM, so killing it
# destroys the guest and the volume survives.
#
# M7_CACHE holds firecracker, vmlinux and rootfs.ext4 (m7-rehearse.sh builds them).
# M7_CACHE_TYPE=Unsafe is the known-bad control for VOL-FLUSH-CONFIG. M7_VMLINUX boots another
# guest kernel and M7_GUEST_MOUNT adds mount options in the guest, both for VOL-DRIFT.
# M7_DRIFT_CHECK=0 skips the fingerprint check, for controls that change the stack on purpose.
# M7_HOST_CHECK=0 skips only its host.* keys, for cases that put the volume on a test filesystem.
# M7_FINGERPRINT reads another fingerprint file, for VOL-DRIFT. M7_ALERT=<bytes> starts the guest's
# capacity alert (scripts/m7/capacity-alert) below that many free bytes, for VOL-CAPACITY.
# M7_REWRITE_CONTROL=1 runs the server built with rewrite-control, the V2 control.
# M7_FENCE=0 skips the flock, only as the VOL-EXCLUSIVE control.
set -eu
: "${M7_CACHE:?set M7_CACHE}"
[ "${1:-}" = --dir ] || { echo "fc-server: want --dir first" >&2; exit 64; }
host=$(dirname "$2")
shift 2
kernel=${M7_VMLINUX:-$M7_CACHE/vmlinux}
cache_type=${M7_CACHE_TYPE:-Writeback}
# M7_IMAGE puts the volume on a host block device instead, such as a device-mapper target that
# VOL-METADATA-ERROR switches to failing writes. The caller formats it.
img=${M7_IMAGE:-$host/log.img}
# V10: the launcher's half of the qualified fingerprint, before anything boots. The guest checks
# its half before the log opens (scripts/m7/guest-init).
fingerprint=${M7_FINGERPRINT:-$(dirname "$0")/fingerprint}
drift=
if [ "${M7_DRIFT_CHECK:-1}" = 0 ]; then
	drift=m7.drift=off
elif [ -r "$fingerprint" ]; then
	fields="vmm.cache_type=$cache_type
vmm.firecracker=$("$M7_CACHE/firecracker" --version | head -n 1)"
	if [ "${M7_HOST_CHECK:-1}" != 0 ]; then
		# A block device image is a test layer (dm, loop) over a backing file in the host dir.
		if [ -b "$img" ]; then on=$host; else on=$(dirname "$img"); fi
		fields="$fields
$("$(dirname "$0")/fingerprint-host" "$on")"
	fi
	while IFS= read -r field; do
		key=${field%%=*}
		want=$(sed -n "s/^$key=//p" "$fingerprint")
		[ "$want" != unpinned ] || continue
		[ "${field#*=}" = "$want" ] ||
			{ echo "fc-server: drift: $key is '${field#*=}', qualified '$want'" >&2; exit 78; }
	done <<EOF
$fields
EOF
fi
if [ ! -e "$img" ]; then
	truncate -s "${M7_LOG_BYTES:-1G}" "$img"
	/sbin/mkfs.ext4 -q -F "$img"
fi
# V5: one VMM per volume. The lock rides on fd 9 into the VMM through exec, so it lasts exactly
# as long as the VMM process, including while it is paused.
exec 9<>"$img"
[ "${M7_FENCE:-1}" = 0 ] || flock -xn 9 || { echo "fc-server: $img is attached to another VMM" >&2; exit 75; }
rm -f "$host/v.sock"
# A read-only server (ADR 0060) gets the volume read-only, so the guest cannot write to it at all.
case " $* " in *" --read-only "*) ro=true ;; *) ro=false ;; esac
cat >"$host/vm.json" <<EOF
{
  "boot-source": {
    "kernel_image_path": "$kernel",
    "boot_args": "console=ttyS0 reboot=k panic=1 ro $drift ${M7_GUEST_MOUNT:+m7.mount=$M7_GUEST_MOUNT} ${M7_REWRITE_CONTROL:+m7.control=rewrite} ${M7_ALERT:+m7.alert=$M7_ALERT} init=/segment-log-init -- $*"
  },
  "drives": [
    {"drive_id": "root", "path_on_host": "$M7_CACHE/rootfs.ext4", "is_root_device": true, "is_read_only": true},
    {"drive_id": "log", "path_on_host": "$img", "is_root_device": false, "is_read_only": $ro,
     "cache_type": "$cache_type"}
  ],
  "machine-config": {"vcpu_count": ${M7_VCPUS:-2}, "mem_size_mib": ${M7_MEM_MIB:-256}},
  "vsock": {"guest_cid": 3, "uds_path": "$host/v.sock"}
}
EOF
# The VMM holds one host descriptor per vsock connection, up to its muxer's 1,023. At the usual
# soft limit of 1,024 it fails to accept the rest, and they wait in the socket's queue forever.
# shellcheck disable=SC3045 # dash and bash both have ulimit -n and -H
ulimit -n 4096 2>/dev/null || ulimit -n "$(ulimit -Hn)"
exec "$M7_CACHE/firecracker" --no-api --config-file "$host/vm.json" >"$host/console.log"
