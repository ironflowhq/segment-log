#!/bin/sh
# PID 1 in an M7 guest (ADR 0059). The log volume is the second drive, /dev/vdb. The kernel
# passes the words after "--" in boot_args as our arguments; they go to the server.
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
# A read-only server gets a read-only drive (scripts/m7/fc-server), so the mount must match.
case " $* " in *" --read-only "*) mode=ro ;; *) mode=rw ;; esac
# V3: a metadata write error must stop the filesystem; ext4's default is to continue.
# m7.mount= on the kernel command line adds options, so that VOL-DRIFT can change one.
extra=
server=/segment-log-server
# shellcheck disable=SC2013 # the command line is words
for word in $(cat /proc/cmdline); do
	case $word in
	m7.mount=*) extra=,${word#m7.mount=} ;;
	m7.control=rewrite) server=/segment-log-server-control ;; # the V2 control build
	esac
done
mount -t ext4 -o "$mode,errors=remount-ro$extra" /dev/vdb /mnt || { echo "m7: cannot mount /dev/vdb"; ls -l /dev/vd*; dmesg | tail -n 5; reboot -f; }
# VOL-FS-CHECK and VOL-FLUSH-CONFIG read these lines from the console.
fs=$(findmnt -no SOURCE,FSTYPE,OPTIONS -T /mnt | tr -s ' ')
write_cache=$(cat /sys/block/vdb/queue/write_cache)
echo "m7: kernel $(uname -r)"
echo "m7: fs $fs"
echo "m7: write_cache $write_cache"
# V10: the guest's half of the qualified fingerprint (scripts/m7/fingerprint). On a mismatch the
# log never opens, and the console names the field. Controls that change the stack on purpose boot
# with m7.drift=off.
if [ -r /etc/m7-fingerprint ] && ! grep -qw m7.drift=off /proc/cmdline; then
	# A reader mounts read-only by design (ADR 0060); every other option must match.
	qualified_fs=$(echo "$fs" | sed 's/ ro,/ rw,/')
	drift=$(printf 'guest.kernel=%s\nguest.fs=%s\nguest.write_cache=%s\n' "$(uname -r)" "$qualified_fs" "$write_cache" |
		while IFS= read -r line; do
			key=${line%%=*}
			grep -qxF "$line" /etc/m7-fingerprint ||
				echo "m7: drift: $key is '${line#*=}', qualified '$(sed -n "s/^$key=//p" /etc/m7-fingerprint)'"
		done)
	if [ -n "$drift" ]; then
		echo "$drift"
		umount /mnt
		reboot -f
	fi
fi
# VOL-METADATA-ERROR: the V3 steps run in place of the server, and the host answers each cue on
# the serial console after it switches the device (scripts/m7-metadata-error.sh).
if [ "${1:-}" = --metaerr ]; then
	dmesg -n 1 # kernel messages would split the step lines on the console
	/segment-log-probe metaerr -dir /mnt/metaerr </dev/console 2>&1 | sed 's/^/m7: /'
	dmesg | grep -iE 'i/o error|ext4-fs|journal' | sed 's/^/m7: dmesg /'
	echo "m7: mounted $(findmnt -no OPTIONS -T /mnt)"
	reboot -f
fi
# VOL-FLUSH-LATENCY: the flush probe runs in place of the server (scripts/m7-flush-latency.sh).
if [ "${1:-}" = --probe ]; then
	shift
	mkdir -p /mnt/probe
	/segment-log-probe probe -dir /mnt/probe "$@" 2>&1 | sed 's/^/m7: /'
	umount /mnt
	reboot -f
fi
mount -t tmpfs run /run
echo 1 >/proc/sys/kernel/sysrq
# Power-cut harness events arrive as lines on the serial console (scripts/m7-power-cut.sh).
while read -r event; do
	case $event in
	kill) kill -KILL "$(cat /run/server.pid)" ;; # process crash
	crash) echo c >/proc/sysrq-trigger ;;        # guest crash
	esac
done </dev/console & # explicit: sh gives a background job /dev/null as its input
# The supervisor: a crash or a poisoned writer restarts the server, and its open recovers the log
# (ADR 0058). A seal or a signal (0) or a failed open (1) ends the guest.
while :; do
	"$server" --dir /mnt/log "$@" &
	echo $! >/run/server.pid
	wait $!
	code=$?
	echo "m7: server exit $code"
	case $code in 0 | 1) break ;; esac
done
umount /mnt
reboot -f
