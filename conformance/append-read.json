{
  "case": "TRANSPORT-CONFORMANCE",
  "name": "appends read back with their positions, watermark and stream heads",
  "steps": [
    {"append": [{"stream": "a", "expected": "empty", "key": "k1", "payload": "one"}],
     "expect": {"status": "Ok", "positions": [[0, 0]], "deduplicated": false}},
    {"append": [{"stream": "a", "expected": 0, "payload": "two"}, {"stream": "b", "expected": "empty", "payload": "three"}],
     "expect": {"status": "Ok", "positions": [[1, 1], [2, 0]], "deduplicated": false}},
    {"read": {"from": 0, "max": 10},
     "expect": {"status": "Ok", "records": [
       {"offset": 0, "revision": 0, "stream": "a", "key": "k1", "payload": "one"},
       {"offset": 1, "revision": 1, "stream": "a", "key": null, "payload": "two"},
       {"offset": 2, "revision": 0, "stream": "b", "key": null, "payload": "three"}]}},
    {"read": {"from": 1, "max": 1},
     "expect": {"status": "Ok", "records": [{"offset": 1, "revision": 1, "stream": "a", "key": null, "payload": "two"}]}},
    {"read": {"from": 3, "max": 10}, "expect": {"status": "Ok", "records": []}},
    {"watermark": {}, "expect": {"status": "Ok", "watermark": 3}},
    {"stream_head": "a", "expect": {"status": "Ok", "head": {"revision": 1, "offset": 1}}},
    {"stream_head": "zz", "expect": {"status": "Ok", "absent": true}}
  ]
}
